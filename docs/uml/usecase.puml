@startuml
left to right direction
skinparam packageStyle rectangle

actor User

rectangle "COLORS Web Application" {
  usecase "Log In" as UC1
  usecase "Access Color Page" as UC2
  usecase "Add Color" as UC3
  usecase "Search Colors" as UC4
  usecase "View Results" as UC5
  usecase "Log Out" as UC6
}

User --> UC1
User --> UC3
User --> UC4
User --> UC6

UC1 .> UC2 : <<include>>
UC4 .> UC5 : <<include>>

@enduml